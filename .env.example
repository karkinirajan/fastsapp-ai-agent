# Copy to .env and fill in. All values here are demo values.

# OpenAI
OPENAI_API_KEY=sk-demo-replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MAX_COMPLETION_TOKENS=512
TEMPERATURE=0.7
OPENAI_TIMEOUT=30

# Cohere (reranking)
COHERE_API_KEY=demo-replace-me
COHERE_RERANK_MODEL=rerank-v4.0-fast
COHERE_RERANK_TOP_N=3
VECTORSTORE_QUERY_N=8

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=ACdemo
TWILIO_AUTH_TOKEN=demo-replace-me
TWILIO_NUMBER=+14155238886
# Twilio signs every webhook call; unsigned or forged calls get 403. Switch off only for local experiments.
VALIDATE_TWILIO_SIGNATURE=true
# The address Twilio calls (needed behind a TLS-terminating proxy, where the app sees http and an
# internal host), e.g. https://bot.example.com
PUBLIC_URL=

# PostgreSQL
DB_USER=fastsapp
DB_PASSWORD=demo-password
DB_HOST=localhost
DB_NAME=fastsapp_ai_agent
DB_PORT=5432

# FAQ vectorstore
VECTORSTORE_PATH=./vectorstore
CONTENT_CSV_PATH=./content/adventistFAQ.csv

# Conversation memory
MAX_HISTORY_MESSAGES=10
SUMMARIZE_THRESHOLD=8

# Escalation
ESCALATION_SENTIMENT_THRESHOLD=-0.5
ESCALATION_CONTACT_PHONE=

# The bot persona (SYSTEM_PROMPT) has a Chinese default in app/config.py; set it here to override.
